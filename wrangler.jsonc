{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nokohub",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-18",

  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js"]
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nokohub-db",
      "database_id": "8b8e5122-408b-4d31-81b3-10105ebb5325",
      "migrations_dir": "migrations"
    }
  ]
}
